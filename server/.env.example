# ---- Server ----
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Signs the anonymous session cookie (any long random string). Required in production.
SESSION_SECRET=

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/vibe-chat

# ---- AI provider: "gemini" | "anthropic" | "openai" ----
# Only the key for the active provider is required.
# SECURITY: copy this file to .env and fill in the key there. .env is
# git-ignored; the key never leaves the server process.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the primary model's free-tier daily quota is exhausted
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Thread titles: "heuristic" (from the first prompt, no API call – default)
# or "ai" (one extra model request per thread; nicer, costs quota)
AUTO_TITLE=heuristic

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
